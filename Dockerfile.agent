# syntax=docker/dockerfile:1
FROM python:3.11-alpine

WORKDIR /app

# Install standard ca-certificates and tzdata
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10002 hydroagent

USER hydroagent

# Copy Python ML Diagnostic & Control Agent package
COPY --chown=hydroagent:hydroagent hydro_agent /app/hydro_agent

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV HYDRO_TWIN_URL=http://hydro:8080
ENV HYDRO_ML_API_KEY=sensor-x-dev-ml-key
ENV HYDRO_LOG_LEVEL=info

# Run unit tests during build to guarantee model integrity
RUN python -m unittest discover -s hydro_agent -p "test_*.py"

ENTRYPOINT ["python", "-m", "hydro_agent.main"]

