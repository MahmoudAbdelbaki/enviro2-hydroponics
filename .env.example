# HTTP listen address for REST API and POST /mcp endpoint
HYDRO_HTTP_ADDR=:8080

# PostgreSQL connection string (leave empty to run with the thread-safe in-memory store)
HYDRO_DATABASE_URL=postgres://hydro:hydro_dev_password@localhost:5432/hydro?sslmode=disable

# Constant-time Bearer token required for ML actuation (POST .../commands) and alerts (POST .../alerts)
HYDRO_ML_API_KEY=sensor-x-dev-ml-key

# Structured JSON log level: debug, info, warn, error
HYDRO_LOG_LEVEL=info
